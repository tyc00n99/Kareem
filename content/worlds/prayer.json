    {
      "id": "prayer-steps",
      "title": "How to pray",
      "emoji": "🧎",
      "status": "draft",
      "screens": [
        {
          "type": "learn",
          "text": "I stand on my prayer mat and face the Qibla.",
          "picture": {
            "emoji": "🧍",
            "alt": "I stand on my prayer mat and face the Qibla."
          }
        },
        {
          "type": "learn",
          "text": "I raise my hands and say Allahu Akbar.",
          "picture": {
            "emoji": "🙌",
            "alt": "I raise my hands and say Allahu Akbar."
          },
          "arabic": {
            "text": "اللَّهُ أَكْبَرُ",
            "say": "Allahu Akbar"
          }
        },
        {
          "type": "learn",
          "text": "I fold my hands and read Surah Al-Fatiha.",
          "picture": {
            "emoji": "🤲",
            "alt": "I fold my hands and read Surah Al-Fatiha."
          },
          "arabic": {
            "text": "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ",
            "say": "Alhamdu lillahi Rabbil-'alamin"
          }
        },
        {
          "type": "learn",
          "text": "I bow down.",
          "picture": {
            "emoji": "🙇",
            "alt": "I bow down."
          }
        },
        {
          "type": "learn",
          "text": "This is ruku.",
          "picture": {
            "emoji": "🙇",
            "alt": "This is ruku."
          }
        },
        {
          "type": "learn",
          "text": "I say Subhana Rabbiyal-Azim.",
          "picture": {
            "emoji": "🙇",
            "alt": "I say Subhana Rabbiyal-Azim."
          },
          "arabic": {
            "text": "سُبْحَانَ رَبِّيَ الْعَظِيمِ",
            "say": "Subhana Rabbiyal-'Azim"
          }
        },
        {
          "type": "learn",
          "text": "I stand up and say Sami Allahu liman hamidah.",
          "picture": {
            "emoji": "🧍",
            "alt": "I stand up and say Sami Allahu liman hamidah."
          },
          "arabic": {
            "text": "سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ",
            "say": "Sami'Allahu liman hamidah"
          }
        },
        {
          "type": "learn",
          "text": "I put my head down on the mat.",
          "picture": {
            "emoji": "🧎",
            "alt": "I put my head down on the mat."
          }
        },
        {
          "type": "learn",
          "text": "This is sujood.",
          "picture": {
            "emoji": "🧎",
            "alt": "This is sujood."
          }
        },
        {
          "type": "learn",
          "text": "I say Subhana Rabbiyal-A'la.",
          "picture": {
            "emoji": "🧎",
            "alt": "I say Subhana Rabbiyal-A'la."
          },
          "arabic": {
            "text": "سُبْحَانَ رَبِّيَ الْأَعْلَى",
            "say": "Subhana Rabbiyal-A'la"
          }
        },
        {
          "type": "learn",
          "text": "I sit up for a moment.",
          "picture": {
            "emoji": "🪑",
            "alt": "I sit up for a moment."
          }
        },
        {
          "type": "learn",
          "text": "I do sujood one more time.",
          "picture": {
            "emoji": "🧎",
            "alt": "I do sujood one more time."
          }
        },
        {
          "type": "learn",
          "text": "At the end I sit and say the tashahhud.",
          "picture": {
            "emoji": "☝️",
            "alt": "At the end I sit and say the tashahhud."
          }
        },
        {
          "type": "learn",
          "text": "I turn my head right and say Assalamu alaykum wa rahmatullah.",
          "picture": {
            "emoji": "👉",
            "alt": "I turn my head right and say Assalamu alaykum wa rahmatullah."
          },
          "arabic": {
            "text": "السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ",
            "say": "Assalamu 'alaykum wa rahmatullah"
          }
        },
        {
          "type": "learn",
          "text": "I turn my head left and say it again.",
          "picture": {
            "emoji": "👈",
            "alt": "I turn my head left and say it again."
          }
        },
        {
          "type": "learn",
          "text": "I finished my prayer! Alhamdulillah.",
          "picture": {
            "emoji": "⭐",
            "alt": "I finished my prayer! Alhamdulillah."
          }
        }
      ]
    },

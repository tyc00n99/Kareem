    {
      "id": "surah-ikhlas",
      "title": "Surah Al-Ikhlas",
      "emoji": "☝️",
      "status": "draft",
      "screens": [
        {
          "type": "learn",
          "text": "Say: He is Allah, the One.",
          "picture": {
            "emoji": "🤲",
            "alt": "Say: He is Allah, the One."
          },
          "arabic": {
            "text": "قُلْ هُوَ اللَّهُ أَحَدٌ",
            "say": "Qul huwa Allahu ahad"
          }
        },
        {
          "type": "learn",
          "text": "Allah needs no one.",
          "picture": {
            "emoji": "💛",
            "alt": "Allah needs no one."
          },
          "arabic": {
            "text": "اللَّهُ الصَّمَدُ",
            "say": "Allahus-samad"
          }
        },
        {
          "type": "learn",
          "text": "He has no children and no parents.",
          "picture": {
            "emoji": "🌟",
            "alt": "He has no children and no parents."
          },
          "arabic": {
            "text": "لَمْ يَلِدْ وَلَمْ يُولَدْ",
            "say": "Lam yalid wa lam yulad"
          }
        },
        {
          "type": "learn",
          "text": "Nothing is like Allah.",
          "picture": {
            "emoji": "☝️",
            "alt": "Nothing is like Allah."
          },
          "arabic": {
            "text": "وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ",
            "say": "Wa lam yakul-lahu kufuwan ahad"
          }
        }
      ]
    },
    {
      "id": "surah-falaq",
      "title": "Surah Al-Falaq",
      "emoji": "🌄",
      "status": "draft",
      "screens": [
        {
          "type": "learn",
          "text": "Say: I ask the Lord of the morning to keep me safe.",
          "picture": {
            "emoji": "🌄",
            "alt": "Say: I ask the Lord of the morning to keep me safe."
          },
          "arabic": {
            "text": "قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ",
            "say": "Qul a'udhu bi Rabbil-falaq"
          }
        },
        {
          "type": "learn",
          "text": "From bad things He made.",
          "picture": {
            "emoji": "🛡️",
            "alt": "From bad things He made."
          },
          "arabic": {
            "text": "مِن شَرِّ مَا خَلَقَ",
            "say": "Min sharri ma khalaq"
          }
        },
        {
          "type": "learn",
          "text": "From the dark night.",
          "picture": {
            "emoji": "🌑",
            "alt": "From the dark night."
          },
          "arabic": {
            "text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
            "say": "Wa min sharri ghasiqin idha waqab"
          }
        },
        {
          "type": "learn",
          "text": "From those who blow on knots.",
          "picture": {
            "emoji": "🪢",
            "alt": "From those who blow on knots."
          },
          "arabic": {
            "text": "وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ",
            "say": "Wa min sharrin-naffathati fil-'uqad"
          }
        },
        {
          "type": "learn",
          "text": "From people who are jealous.",
          "picture": {
            "emoji": "😠",
            "alt": "From people who are jealous."
          },
          "arabic": {
            "text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
            "say": "Wa min sharri hasidin idha hasad"
          }
        }
      ]
    },
    {
      "id": "surah-nas",
      "title": "Surah An-Nas",
      "emoji": "👨‍👩‍👧",
      "status": "draft",
      "screens": [
        {
          "type": "learn",
          "text": "Say: I ask the Lord of people to keep me safe.",
          "picture": {
            "emoji": "🛡️",
            "alt": "Say: I ask the Lord of people to keep me safe."
          },
          "arabic": {
            "text": "قُلْ أَعُوذُ بِرَبِّ النَّاسِ",
            "say": "Qul a'udhu bi Rabbin-nas"
          }
        },
        {
          "type": "learn",
          "text": "The King of people.",
          "picture": {
            "emoji": "👑",
            "alt": "The King of people."
          },
          "arabic": {
            "text": "مَلِكِ النَّاسِ",
            "say": "Malikin-nas"
          }
        },
        {
          "type": "learn",
          "text": "The God of people.",
          "picture": {
            "emoji": "☝️",
            "alt": "The God of people."
          },
          "arabic": {
            "text": "إِلَٰهِ النَّاسِ",
            "say": "Ilahin-nas"
          }
        },
        {
          "type": "learn",
          "text": "From the bad whispers.",
          "picture": {
            "emoji": "🙈",
            "alt": "From the bad whispers."
          },
          "arabic": {
            "text": "مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ",
            "say": "Min sharril-waswasil-khannas"
          }
        },
        {
          "type": "learn",
          "text": "That whisper in people's hearts.",
          "picture": {
            "emoji": "💭",
            "alt": "That whisper in people's hearts."
          },
          "arabic": {
            "text": "الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ",
            "say": "Alladhi yuwaswisu fi sudurin-nas"
          }
        },
        {
          "type": "learn",
          "text": "From jinn and people.",
          "picture": {
            "emoji": "👥",
            "alt": "From jinn and people."
          },
          "arabic": {
            "text": "مِنَ الْجِنَّةِ وَالنَّاسِ",
            "say": "Minal-jinnati wan-nas"
          }
        }
      ]
    },
    {
      "id": "surah-fatiha",
      "title": "Surah Al-Fatiha",
      "emoji": "📖",
      "status": "draft",
      "screens": [
        {
          "type": "learn",
          "text": "In the name of Allah, the Kind, the Caring.",
          "picture": {
            "emoji": "🤲",
            "alt": "In the name of Allah, the Kind, the Caring."
          },
          "arabic": {
            "text": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ",
            "say": "Bismillahir-Rahmanir-Rahim"
          }
        },
        {
          "type": "learn",
          "text": "All thanks to Allah, Lord of everything.",
          "picture": {
            "emoji": "🌍",
            "alt": "All thanks to Allah, Lord of everything."
          },
          "arabic": {
            "text": "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ",
            "say": "Alhamdu lillahi Rabbil-'alamin"
          }
        },
        {
          "type": "learn",
          "text": "The Kind, the Caring.",
          "picture": {
            "emoji": "💛",
            "alt": "The Kind, the Caring."
          },
          "arabic": {
            "text": "الرَّحْمَٰنِ الرَّحِيمِ",
            "say": "Ar-Rahmanir-Rahim"
          }
        },
        {
          "type": "learn",
          "text": "King of the Last Day.",
          "picture": {
            "emoji": "👑",
            "alt": "King of the Last Day."
          },
          "arabic": {
            "text": "مَالِكِ يَوْمِ الدِّينِ",
            "say": "Maliki yawmid-din"
          }
        },
        {
          "type": "learn",
          "text": "Only You we worship, only You we ask for help.",
          "picture": {
            "emoji": "🙏",
            "alt": "Only You we worship, only You we ask for help."
          },
          "arabic": {
            "text": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",
            "say": "Iyyaka na'budu wa iyyaka nasta'in"
          }
        },
        {
          "type": "learn",
          "text": "Show us the straight path.",
          "picture": {
            "emoji": "🛤️",
            "alt": "Show us the straight path."
          },
          "arabic": {
            "text": "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ",
            "say": "Ihdinas-siratal-mustaqim"
          }
        },
        {
          "type": "learn",
          "text": "The path of people You blessed.",
          "picture": {
            "emoji": "🌟",
            "alt": "The path of people You blessed."
          },
          "arabic": {
            "text": "صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ",
            "say": "Siratal-ladhina an'amta 'alayhim, ghayril-maghdubi 'alayhim wa lad-dallin"
          }
        }
      ]
    },

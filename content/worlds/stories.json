      "id": "story-adam",
      "title": "Prophet Adam",
      "emoji": "🌱",
      "status": "draft",
      "screens": [
        {
          "type": "learn",
          "text": "Allah made the first person. His name was Adam, peace be upon him.",
          "picture": {
            "emoji": "🌍",
            "alt": "Allah made the first person. His name was Adam, peace be upon him."
          }
        },
        {
          "type": "learn",
          "text": "Adam lived in a beautiful garden called Jannah.",
          "picture": {
            "emoji": "🌳",
            "alt": "Adam lived in a beautiful garden called Jannah."
          }
        },
        {
          "type": "learn",
          "text": "Allah said: Do not eat from one tree. Adam forgot and ate from it.",
          "picture": {
            "emoji": "🍎",
            "alt": "Allah said: Do not eat from one tree. Adam forgot and ate from it."
          }
        },
        {
          "type": "learn",
          "text": "Adam felt sorry and said sorry to Allah.",
          "picture": {
            "emoji": "💛",
            "alt": "Adam felt sorry and said sorry to Allah."
          }
        },
        {
          "type": "learn",
          "text": "Allah forgave him. When we make a mistake, we can say sorry too.",
          "picture": {
            "emoji": "💛",
            "alt": "Allah forgave him. When we make a mistake, we can say sorry too."
          }
        }
      ]
    },

        },
        {
          "type": "learn",
          "text": "His father Abdullah died before he was born.",
          "picture": {
            "emoji": "💔",
            "alt": "His father Abdullah died before he was born."
          }
        },
        {
          "type": "learn",
          "text": "He lived in the desert with a kind lady named Halimah. He helped look after sheep.",
          "picture": {
            "emoji": "🐑",
            "alt": "He lived in the desert with a kind lady named Halimah. He helped look after sheep."
          }
        },
        {
          "type": "learn",
          "text": "His grandfather, and then his uncle Abu Talib, took care of him.",
          "picture": {
            "emoji": "💛",
            "alt": "His grandfather, and then his uncle Abu Talib, took care of him."
          }
        }

    {
      "id": "wudu-steps",
      "title": "How to make wudu",
      "emoji": "💧",
      "status": "draft",
      "screens": [
        {
          "type": "learn",
          "text": "I want to make wudu. I say Bismillah.",
          "picture": {
            "emoji": "💭",
            "alt": "I want to make wudu. I say Bismillah."
          },
          "arabic": {
            "text": "بِسْمِ اللَّهِ",
            "say": "Bismillah"
          }
        },
        {
          "type": "learn",
          "text": "I wash my hands. One, two, three.",
          "picture": {
            "emoji": "🙌",
            "alt": "I wash my hands. One, two, three."
          }
        },
        {
          "type": "learn",
          "text": "I rinse my mouth. One, two, three.",
          "picture": {
            "emoji": "👄",
            "alt": "I rinse my mouth. One, two, three."
          }
        },
        {
          "type": "learn",
          "text": "I rinse my nose gently. One, two, three.",
          "picture": {
            "emoji": "👃",
            "alt": "I rinse my nose gently. One, two, three."
          }
        },
        {
          "type": "learn",
          "text": "I wash my face. One, two, three.",
          "picture": {
            "emoji": "😊",
            "alt": "I wash my face. One, two, three."
          }
        },
        {
          "type": "learn",
          "text": "I wash my right arm to the elbow, then my left arm. Three times each.",
          "picture": {
            "emoji": "💪",
            "alt": "I wash my right arm to the elbow, then my left arm. Three times each."
          }
        },
        {
          "type": "learn",
          "text": "I wipe my wet hands over my head. One time.",
          "picture": {
            "emoji": "🧑",
            "alt": "I wipe my wet hands over my head. One time."
          }
        },
        {
          "type": "learn",
          "text": "I wipe my ears. One time.",
          "picture": {
            "emoji": "👂",
            "alt": "I wipe my ears. One time."
          }
        },
        {
          "type": "learn",
          "text": "I wash my right foot, then my left foot. Three times each.",
          "picture": {
            "emoji": "🦶",
            "alt": "I wash my right foot, then my left foot. Three times each."
          }
        },
        {
          "type": "learn",
          "text": "All done! Now I am ready to pray.",
          "picture": {
            "emoji": "⭐",
            "alt": "All done! Now I am ready to pray."
          }
        }
      ]
    },

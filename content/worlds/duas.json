    {
      "id": "dua-waking",
      "title": "When I wake up",
      "emoji": "🌅",
      "status": "draft",
      "screens": [
        {
          "type": "learn",
          "text": "I open my eyes in the morning.",
          "picture": {
            "emoji": "🛏️",
            "alt": "I open my eyes in the morning."
          }
        },
        {
          "type": "learn",
          "text": "I say the waking up dua.",
          "picture": {
            "emoji": "🤲",
            "alt": "I say the waking up dua."
          },
          "arabic": {
            "text": "الْحَمْدُ لِلَّهِ الَّذِي أَحْيَانَا بَعْدَ مَا أَمَاتَنَا وَإِلَيْهِ النُّشُورُ",
            "say": "Alhamdu lillahil-ladhi ahyana ba'da ma amatana wa ilayhin-nushur"
          }
        },
        {
          "type": "learn",
          "text": "It means: Thank you Allah for waking me up.",
          "picture": {
            "emoji": "💛",
            "alt": "It means: Thank you Allah for waking me up."
          }
        }
      ]
    },
    {
      "id": "dua-eating",
      "title": "Before and after eating",
      "emoji": "🍽️",
      "status": "draft",
      "screens": [
        {
          "type": "learn",
          "text": "Before I eat, I say Bismillah.",
          "picture": {
            "emoji": "🍎",
            "alt": "Before I eat, I say Bismillah."
          },
          "arabic": {
            "text": "بِسْمِ اللَّهِ",
            "say": "Bismillah"
          }
        },
        {
          "type": "learn",
          "text": "I eat with my right hand.",
          "picture": {
            "emoji": "🤚",
            "alt": "I eat with my right hand."
          }
        },
        {
          "type": "learn",
          "text": "After I eat, I say Alhamdulillah.",
          "picture": {
            "emoji": "😋",
            "alt": "After I eat, I say Alhamdulillah."
          },
          "arabic": {
            "text": "الْحَمْدُ لِلَّهِ",
            "say": "Alhamdulillah"
          }
        }
      ]
    },
    {

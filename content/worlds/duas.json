    {
      "id": "dua-home",
      "title": "Coming home",
      "emoji": "🏠",
      "status": "draft",
      "screens": [
        {
          "type": "learn",
          "text": "I walk into my home.",
          "picture": {
            "emoji": "🚪",
            "alt": "I walk into my home."
          }
        },
        {
          "type": "learn",
          "text": "I say the home dua.",
          "picture": {
            "emoji": "🤲",
            "alt": "I say the home dua."
          },
          "arabic": {
            "text": "بِسْمِ اللَّهِ وَلَجْنَا وَبِسْمِ اللَّهِ خَرَجْنَا وَعَلَى رَبِّنَا تَوَكَّلْنَا",
            "say": "Bismillahi walajna, wa bismillahi kharajna, wa 'ala Rabbina tawakkalna"
          }
        },
        {
          "type": "learn",
          "text": "I say Assalamu alaykum to my family.",
          "picture": {
            "emoji": "👋",
            "alt": "I say Assalamu alaykum to my family."
          },
          "arabic": {
            "text": "السَّلَامُ عَلَيْكُمْ",
            "say": "Assalamu 'alaykum"
          }
        }
      ]
    },
    {
      "id": "dua-bathroom",

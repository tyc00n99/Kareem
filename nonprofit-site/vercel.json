{
  "cleanUrls": true,
  "redirects": [
    { "source": "/Home", "destination": "/", "permanent": true },
    { "source": "/About", "destination": "/#work", "permanent": true },
    { "source": "/Clothes", "destination": "/#work", "permanent": true },
    { "source": "/Donate", "destination": "https://www.gofundme.com/f/help-kareem-provide-warmth-and-food-globally", "permanent": false },
    { "source": "/Dashboard", "destination": "/", "permanent": false }
  ],
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
